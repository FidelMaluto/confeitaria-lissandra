# URL do projeto Supabase (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service Role Key (Settings > API > service_role) - NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key

# Porta do servidor Express
PORT=3333

# Origem permitida no CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173
